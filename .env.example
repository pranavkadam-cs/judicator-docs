# ─────────────────────────────────────────────────────────────
#  Vigil.OS — Environment Configuration Template
#  Copy this file to .env and fill in your secrets
# ─────────────────────────────────────────────────────────────

# Google Gemini Multimodal AI OCR Engine
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT_NUMBER=your_project_number_here
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_key_here

# OCR Provider Selection: "auto" | "gemini" | "google-vision" | "tesseract"
# "auto" = Google Gemini AI primary with Tesseract fallback
OCR_PROVIDER=auto

# ─────────────────────────────────────────────────────────────
#  Hyperledger Fabric Blockchain (leave ALL blank for simulation mode)
#  Simulation mode: cryptographically chained local ledger (.data/blockchain-ledger.json)
#  Live mode: connects to a real Hyperledger Fabric peer via gRPC
# ─────────────────────────────────────────────────────────────

# gRPC endpoint of the Fabric peer (e.g. localhost:7051)
FABRIC_PEER_ENDPOINT=

# Membership Service Provider ID (e.g. Org1MSP)
FABRIC_MSP_ID=

# Channel name (e.g. vigil-channel)
FABRIC_CHANNEL_NAME=

# Chaincode/smart contract name (e.g. DocumentNotaryCC)
FABRIC_CHAINCODE_NAME=

# Path to the user identity certificate PEM file
FABRIC_CERT_PATH=

# Path to the user private key PEM file
FABRIC_KEY_PATH=

# Path to the peer TLS root certificate PEM file
FABRIC_TLS_CERT_PATH=
