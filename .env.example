# ─────────────────────────────────────────────────────────────
#  Vigil.OS — Environment Configuration Template
#  Copy this file to .env and fill in your actual values
#  NEVER commit the .env file with real credentials
# ─────────────────────────────────────────────────────────────

# Google Cloud Vision API — OCR Provider
GOOGLE_CLOUD_PROJECT_NUMBER=your_project_number_here
GOOGLE_CLOUD_VISION_API_KEY=your_api_key_here

# OCR Provider Selection: "google-vision" | "tesseract" | "auto"
# "auto" = Google Vision primary with Tesseract fallback
# "tesseract" = Local-only Tesseract.js (no API key needed)
OCR_PROVIDER=auto
